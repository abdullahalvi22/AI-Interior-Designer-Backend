NODE_ENV=development
PORT=3000

# Local MySQL / Docker Compose. Keep MYSQL_PASSWORD and DATABASE_URL in sync.
MYSQL_DATABASE=roomcraft
MYSQL_USER=roomcraft
MYSQL_PASSWORD=roomcraft
MYSQL_ROOT_PASSWORD=change-this-root-password
DATABASE_URL=mysql://roomcraft:roomcraft@localhost:3306/roomcraft
DATABASE_SSL=false
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
CORS_ORIGINS=*
TRUST_PROXY=false

# Cloudflare R2 (S3-compatible API)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=roomcraft
# Leave blank for a private bucket. The API will return short-lived read URLs.
R2_PUBLIC_BASE_URL=
R2_UPLOAD_URL_TTL_SECONDS=900
R2_READ_URL_TTL_SECONDS=3600
VERIFY_R2_UPLOADS=true
MAX_ROOM_IMAGE_BYTES=20971520

# OpenAI
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=auto
# Optional pricing inputs used to persist estimated actual cost. Keep current.
OPENAI_INPUT_COST_PER_MILLION_USD=0
OPENAI_OUTPUT_COST_PER_MILLION_USD=0

DEFAULT_USER_CREDITS=30
PREVIEW_CREDITS_PER_VARIANT=1
FINAL_CREDITS_PER_VARIANT=3
MAX_DESIGN_VARIANTS=4

RUN_MIGRATIONS=true
RUN_WORKER=true
WORKER_POLL_INTERVAL_MS=2000
WORKER_STALE_AFTER_SECONDS=900
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_BASE_SECONDS=10
